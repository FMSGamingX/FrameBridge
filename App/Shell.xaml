<!-- FrameBridge • Faris Alsari / FMSGaming • Famous Gaming -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource Base}" TextElement.Foreground="{DynamicResource Ink}" TextElement.FontFamily="Segoe UI">
  <Grid.Resources>
    <SolidColorBrush x:Key="Base" Color="#10151D" />
    <SolidColorBrush x:Key="Rail" Color="#141B25" />
    <SolidColorBrush x:Key="Panel" Color="#19222E" />
    <SolidColorBrush x:Key="Field" Color="#222E3D" />
    <SolidColorBrush x:Key="Stroke" Color="#303E50" />
    <SolidColorBrush x:Key="Ink" Color="#F0F5FB" />
    <SolidColorBrush x:Key="Muted" Color="#AAB8C8" />
    <SolidColorBrush x:Key="Mint" Color="#79E6C8" />
    <Style x:Key="Small" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="{DynamicResource Field}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="Opacity" Value=".83" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="box" Property="Opacity" Value=".65" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="box" Property="Opacity" Value=".38" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Padding" Value="13,11" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#152235" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{DynamicResource Field}" CornerRadius="5" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                      <TextBlock Text="⌄" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Margin="0,3,12,3" />
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Margin="10,3,30,3" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" TextElement.Foreground="{DynamicResource Ink}" />
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="#E5ECF2" CornerRadius="4" Padding="3" MaxHeight="280">
                  <ScrollViewer>
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value=".45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Margin" Value="0,8,0,4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Grid.Resources>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="195" />
    <ColumnDefinition />
  </Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Rail}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0" Padding="14,26,13,18">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Top" Margin="7,0,0,35">
        <StackPanel Orientation="Horizontal">
          <Viewbox Width="31" Height="31">
            <Canvas Width="34" Height="34">
              <Path Fill="#79E6C8" Data="M1,10 L10,3 29,3 21,10 11,10 5,16 1,16 Z M7,19 L16,12 34,12 26,19 17,19 8,28 2,28 Z" />
            </Canvas>
          </Viewbox>
          <TextBlock Text="FrameBridge" FontSize="21" FontWeight="SemiBold" Margin="7,0,0,0" />
        </StackPanel>
        <TextBlock Text="FAMOUS GAMING" Foreground="{DynamicResource Muted}" FontSize="10" Margin="38,1,0,0" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="8">
        <Separator Background="{DynamicResource Stroke}" Margin="0,0,0,12" />
        <TextBlock Text="FrameBridge  0.1.0" Style="{StaticResource Small}" />
        <TextBlock Text="Faris Alsari / FMSGaming" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" />
      </StackPanel>
      <StackPanel x:Name="Nav">
        <Button Tag="Dashboard" Style="{StaticResource NavButton}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="31" VerticalAlignment="Center" />
            <TextBlock Text="Dashboard" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Tag="Video inputs" Style="{StaticResource NavButton}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="31" VerticalAlignment="Center" />
            <TextBlock Text="Video inputs" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Tag="Generation" Style="{StaticResource NavButton}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="31" VerticalAlignment="Center" />
            <TextBlock Text="Generation" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Tag="Output" Style="{StaticResource NavButton}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="31" VerticalAlignment="Center" />
            <TextBlock Text="Output" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Tag="Performance" Style="{StaticResource NavButton}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="31" VerticalAlignment="Center" />
            <TextBlock Text="Performance" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Tag="Settings" Style="{StaticResource NavButton}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="31" VerticalAlignment="Center" />
            <TextBlock Text="Settings" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Tag="About" Style="{StaticResource NavButton}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="31" VerticalAlignment="Center" />
            <TextBlock Text="About" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,23,22,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="{DynamicResource Field}" CornerRadius="12" Padding="10,4" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Lamp" Fill="#8291A4" Width="7" Height="7" Margin="0,0,7,0" />
            <TextBlock x:Name="State" Text="Standby" FontSize="12" />
          </StackPanel>
        </Border>
      </StackPanel>
      <TextBlock x:Name="PageTitle" FontSize="31" FontWeight="SemiBold" />
    </DockPanel>
    <TextBlock x:Name="Subtitle" Grid.Row="1" Margin="0,2,0,20" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
    <Grid x:Name="Workspace" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.65*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="PreviewCard" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Margin="16,13">
            <TextBlock x:Name="PreviewTag" DockPanel.Dock="Right" Text="REFERENCE FRAME" Foreground="{DynamicResource Mint}" FontSize="10" VerticalAlignment="Center" />
            <TextBlock Text="Video preview" FontWeight="SemiBold" FontSize="15" />
          </DockPanel>
          <Grid x:Name="VideoStage" ClipToBounds="True" Grid.Row="1" Background="#0B1017">
            <Image x:Name="Still" Stretch="Uniform" />
            <TextBlock x:Name="NoSignal" Text="Waiting for an input signal" Foreground="#AFBECD" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
          </Grid>
          <StackPanel Grid.Row="2" Margin="16,12">
            <TextBlock x:Name="PreviewTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PreviewInfo" Margin="0,3,0,0" Style="{StaticResource Small}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="2" x:Name="Inspector" Style="{StaticResource Card}" Padding="18,14">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="Fields" />
        </ScrollViewer>
      </Border>
    </Grid>
    <UniformGrid Grid.Row="3" Columns="4" Margin="0,14,-9,0">
      <Border Style="{StaticResource Card}" Margin="0,0,9,0" Padding="15,12">
        <StackPanel>
          <TextBlock Text="Input rate" Style="{StaticResource Small}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock x:Name="InputRate" Text="N/A" FontSize="25" FontWeight="SemiBold" Foreground="#EAF2FA" />
            <TextBlock Text="fps" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Bottom" Margin="6,0,0,4" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,9,0" Padding="15,12">
        <StackPanel>
          <TextBlock Text="Output rate" Style="{StaticResource Small}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock x:Name="OutputRate" Text="N/A" FontSize="25" FontWeight="SemiBold" Foreground="#79E6C8" />
            <TextBlock Text="fps" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Bottom" Margin="6,0,0,4" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,9,0" Padding="15,12">
        <StackPanel>
          <TextBlock Text="Pipeline latency" Style="{StaticResource Small}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock x:Name="Latency" Text="N/A" FontSize="25" FontWeight="SemiBold" Foreground="#EAF2FA" />
            <TextBlock Text="ms" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Bottom" Margin="6,0,0,4" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,9,0" Padding="15,12">
        <StackPanel>
          <TextBlock Text="Process CPU" Style="{StaticResource Small}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock x:Name="Cpu" Text="N/A" FontSize="25" FontWeight="SemiBold" Foreground="#EAF2FA" />
            <TextBlock Text="%" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Bottom" Margin="6,0,0,4" />
          </StackPanel>
        </StackPanel>
      </Border>
    </UniformGrid>
    <DockPanel Grid.Row="4" Margin="0,15,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="StopButton" Content="Stop" Margin="0,0,8,0" IsEnabled="False" />
        <Button x:Name="StartButton" Content="Start processing" Background="#79E6C8" Foreground="#0C2422" BorderThickness="0" Padding="18,9" />
      </StackPanel>
      <TextBlock x:Name="Notice" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" FontSize="12" />
    </DockPanel>
  </Grid>
</Grid>